{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "km-poster-generator/content.schema.json",
  "title": "KM Poster Content Schema",
  "description": "Schema for content.json — the data driver for km-poster-generator posters.",
  "type": "object",
  "required": ["title", "subtitle", "tags", "intro", "b1", "b2", "b3", "b4", "sum", "a1", "a2", "a3", "footer"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "tags": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "intro": { "type": "string", "minLength": 1 },
    "b1": { "$ref": "#/$defs/blockCard" },
    "b2": { "$ref": "#/$defs/blockCard" },
    "b3": { "$ref": "#/$defs/blockCard" },
    "b4": { "$ref": "#/$defs/blockCardWithStats" },
    "sum": {
      "type": "object",
      "required": ["label", "main", "sub"],
      "properties": {
        "label": { "type": "string" },
        "main": { "type": "string" },
        "sub": { "type": "string" }
      }
    },
    "a1": { "$ref": "#/$defs/actionCard" },
    "a2": { "$ref": "#/$defs/actionCard" },
    "a3": { "$ref": "#/$defs/actionCard" },
    "footer": { "type": "string" },
    "characters": { "$ref": "#/$defs/characters" }
  },
  "$defs": {
    "blockCard": {
      "type": "object",
      "required": ["title", "item1", "item2", "barlabel", "bar", "barcolor", "highlight"],
      "properties": {
        "title": { "type": "string" },
        "item1": { "type": "string" },
        "item2": { "type": "string" },
        "barlabel": { "type": "string" },
        "bar": { "type": "number", "minimum": 0, "maximum": 100 },
        "barcolor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "highlight": { "type": "string" }
      }
    },
    "blockCardWithStats": {
      "type": "object",
      "required": ["title", "m1", "m1l", "m2", "m2l", "m3", "m3l", "item1", "item2", "barlabel", "bar", "barcolor", "highlight"],
      "properties": {
        "title": { "type": "string" },
        "m1": { "type": "string" },
        "m1l": { "type": "string" },
        "m2": { "type": "string" },
        "m2l": { "type": "string" },
        "m3": { "type": "string" },
        "m3l": { "type": "string" },
        "item1": { "type": "string" },
        "item2": { "type": "string" },
        "barlabel": { "type": "string" },
        "bar": { "type": "number", "minimum": 0, "maximum": 100 },
        "barcolor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "highlight": { "type": "string" }
      }
    },
    "actionCard": {
      "type": "object",
      "required": ["title", "item1", "item2", "highlight"],
      "properties": {
        "title": { "type": "string" },
        "item1": { "type": "string" },
        "item2": { "type": "string" },
        "highlight": { "type": "string" }
      }
    },
    "characters": {
      "type": "object",
      "description": "Optional: override character image paths. Omit to use defaults.",
      "properties": {
        "hero": { "type": "string" },
        "card1": { "type": "string" },
        "card2": { "type": "string" },
        "card3": { "type": "string" },
        "card4": { "type": "string" }
      }
    }
  }
}
